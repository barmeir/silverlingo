GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CENTRAL_CALENDAR_ID=primary

# OpenAI API (GPT-4o-mini Icebreakers)
OPENAI_API_KEY=sk-...
